# =============================================================================
# LLM Integration API - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# All variables without defaults are REQUIRED unless marked optional.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────

# Runtime environment: development | production | test
NODE_ENV=development

# Port the API server listens on
PORT=3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────

# Full PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database_name
DATABASE_URL=postgresql://llm_user:changeme@localhost:5432/llm_api

# ── Cache / Queue (Redis) ───────────────────────────────────────────────────

# Redis connection URL
REDIS_URL=redis://localhost:6379

# ── Authentication (JWT) ─────────────────────────────────────────────────────

# Secret used to sign JWTs. Must be at least 32 characters.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Access token expiry duration (e.g. 15m, 1h, 2d)
JWT_EXPIRES_IN=15m

# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# ── LLM Provider API Keys ───────────────────────────────────────────────────

# OpenAI API key (optional – omit if not using OpenAI)
OPENAI_API_KEY=

# Anthropic API key (optional – omit if not using Anthropic)
ANTHROPIC_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────────────

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Argon2 Password Hashing ─────────────────────────────────────────────────

# Time cost (iterations) for Argon2 hashing
ARGON2_TIME_COST=3

# Memory cost in KiB for Argon2 hashing
ARGON2_MEMORY_COST=65536

# Parallelism degree for Argon2 hashing
ARGON2_PARALLELISM=4

# ── LLM Request Limits ──────────────────────────────────────────────────────

# Timeout for non-streaming completions (milliseconds)
COMPLETION_TIMEOUT_MS=60000

# Timeout for streaming completions (milliseconds)
STREAMING_TIMEOUT_MS=120000

# Maximum number of concurrent LLM API calls
MAX_CONCURRENT_LLM_REQUESTS=10

# ── HTTP Server ──────────────────────────────────────────────────────────────

# Maximum request body size (e.g. 1mb, 10mb)
MAX_BODY_SIZE=1mb

# ── API Key Management ──────────────────────────────────────────────────────

# Prefix applied to generated tenant API keys
API_KEY_PREFIX=llm_live_
